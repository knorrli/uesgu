<%# The locality rows behind the locations browser. Same catalogue idiom as the
    events / locations / genres indexes — filter, search, sort, paginate — with the
    merge link as the one action, since combining two spellings of one town is the
    only thing there is to decide about a locality. %>
<% content_for :title, t('.title') %>
<div class="flex flex-col gap-large">
  <%= render layout: "shared/page_header", locals: { back_path: admin_path, back_label: t("admin.back") } do %>
    <h1><%= t('admin.localities.index.title') %> <span class="muted"><%= @localities.total_count %></span></h1>
  <% end %>

  <%= render "shared/catalogue_controls", route: :admin_localities_path, scope: "admin.localities.index",
        filters: %w[all aliased unsettled], active_filter: @status,
        sorts: %w[name count], active_sort: @sort %>

  <% if @localities.any? %>
    <div class="flex flex-col gap-small">
      <% @localities.each do |locality| %>
        <div class="flex align-baseline gap-medium wrap catalogue-row">
          <%= link_to locality.name, edit_admin_locality_path(locality) %>
          <span class="muted catalogue-count"><%= locality.events_count %>&times;</span>
          <% if locality.alias? %>
            <span class="chip"><%= t('.merged_into', canonical: locality.canonical.name) %></span>
          <% elsif locality.canton.present? %>
            <span class="chip"><%= locality.canton %></span>
          <% else %>
            <span class="chip"><%= t('.canton_unknown') %></span>
          <% end %>
        </div>
      <% end %>
    </div>

    <%= render 'shared/pagination', collection: @localities %>
  <% else %>
    <p class="muted"><%= t('.empty') %></p>
  <% end %>
</div>
