<%# The captured venues behind the venue half of the locations browser. Same
    catalogue idiom as the events / locations / localities indexes — filter, search,
    sort, paginate — with the merge link as the one action. %>
<% content_for :title, t('.title') %>
<div class="flex flex-col gap-large">
  <%= render layout: "shared/page_header", locals: { back_path: admin_path, back_label: t("admin.back") } do %>
    <h1><%= t('admin.places.index.title') %> <span class="muted"><%= @places.total_count %></span></h1>
  <% end %>

  <div class="flex gap-small wrap align-baseline catalogue-filters">
    <% %w[all aliased].each do |status| %>
      <%= link_to t(".status_#{status}"),
            admin_places_path(status: (status == 'all' ? nil : status), q: params[:q].presence, sort: params[:sort].presence),
            class: class_names(:tag, active: @status == status) %>
    <% end %>
  </div>

  <%= form_with url: admin_places_path, method: :get, data: { turbo_frame: '_top' } do %>
    <%= hidden_field_tag :status, params[:status] if params[:status].present? %>
    <%= hidden_field_tag :sort, params[:sort] if params[:sort].present? %>
    <div class="input-wrapper flex">
      <%= text_field_tag :q, params[:q], placeholder: t('.search'), autocomplete: 'off' %>
    </div>
  <% end %>

  <div class="flex gap-small align-baseline muted catalogue-sort">
    <span><%= t('.sort_by') %></span>
    <% %w[name count].each do |sort| %>
      <%= link_to t(".sort_#{sort}"),
            admin_places_path(status: params[:status].presence, q: params[:q].presence, sort: sort),
            class: class_names('catalogue-sort-option', active: @sort == sort) %>
    <% end %>
  </div>

  <% if @places.any? %>
    <div class="flex flex-col gap-small">
      <% @places.each do |place| %>
        <div class="flex align-baseline gap-medium wrap catalogue-row">
          <%= link_to place.name, edit_admin_place_path(place) %>
          <span class="muted catalogue-count"><%= @counts[place.name].to_i %>&times;</span>
          <% if place.alias? %>
            <span class="chip"><%= t('.merged_into', canonical: place.canonical.name) %></span>
          <% else %>
            <span class="chip"><%= t('.placed', locality: place.locality, canton: place.canton) %></span>
          <% end %>
        </div>
      <% end %>
    </div>

    <%= render 'shared/pagination', collection: @places %>
  <% else %>
    <p class="muted"><%= t('.empty') %></p>
  <% end %>
</div>
