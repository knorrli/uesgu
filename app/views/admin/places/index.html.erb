<% content_for :title, t('.title') %>
<div class="flex flex-col gap-large">
  <%= render layout: "shared/page_header", locals: { back_path: admin_path, back_label: t("admin.back") } do %>
    <h1><%= t('admin.places.index.title') %> <span class="muted"><%= @places.total_count %></span></h1>
  <% end %>

  <%= render "shared/catalogue_controls", route: :admin_places_path, scope: "admin.places.index",
        filters: %w[all aliased], active_filter: @status,
        sorts: %w[name count], active_sort: @sort %>

  <% if @places.any? %>
    <div class="flex flex-col gap-small">
      <% @places.each do |place| %>
        <div class="flex align-baseline gap-medium wrap catalogue-row">
          <%= link_to place.name, edit_admin_place_path(place) %>
          <span class="muted catalogue-count"><%= @counts[place.name].to_i %>&times;</span>
          <% if place.alias? %>
            <span class="chip"><%= t('.merged_into', canonical: place.canonical.name) %></span>
          <% else %>
            <span class="chip"><%= t('.placed', locality: place.locality, canton: place.canton) %></span>
          <% end %>
        </div>
      <% end %>
    </div>

    <%= render 'shared/pagination', collection: @places %>
  <% else %>
    <p class="muted"><%= t('.empty') %></p>
  <% end %>
</div>
