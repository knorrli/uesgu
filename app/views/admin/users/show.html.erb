<% content_for :title, @user.username %>
<div class="flex flex-col gap-large">
  <%= render layout: "shared/page_header", locals: { back_path: admin_users_path, back_label: t(".back") } do %>
    <h1>
      <%= @user.username %>
      <% if @user.admin? %><span class="chip"><%= t('admin.users.admin_badge') %></span><% end %>
      <% @user.permissions.each do |permission| %><span class="chip"><%= t("admin.permissions.#{permission}.name") %></span><% end %>
    </h1>
  <% end %>

  <dl class="flex flex-col gap-small">
    <div class="stat">
      <dt><%= t('.email') %></dt>
      <span class="stat__leader"></span>
      <dd class="muted"><%= @user.email_address.presence || t('.no_email') %></dd>
    </div>
    <div class="stat">
      <dt><%= t('.joined') %></dt>
      <span class="stat__leader"></span>
      <dd class="muted"><%= l(@user.created_at.to_date) %></dd>
    </div>
    <div class="stat">
      <dt><%= t('.sessions') %></dt>
      <span class="stat__leader"></span>
      <dd class="muted"><%= @user.sessions.size %></dd>
    </div>
    <div class="stat">
      <dt><%= t('.invited_by') %></dt>
      <span class="stat__leader"></span>
      <dd class="muted">
        <% if @user.accepted_invitation %>
          <%= @user.accepted_invitation.created_by&.username || t('admin.unknown') %>
          <span class="muted">(<%= @user.accepted_invitation.formatted_code %>)</span>
        <% else %>
          —
        <% end %>
      </dd>
    </div>
  </dl>

  <section class="flex flex-col gap-small">
    <h2><%= t('.saved_filters') %></h2>
    <% if @user.saved_filters.any? %>
      <div class="flex gap-small wrap">
        <% @user.saved_filters.each do |rule| %><span class="chip"><%= rule.display_name %></span><% end %>
      </div>
    <% else %>
      <p class="muted">—</p>
    <% end %>
  </section>

  <section class="flex flex-col gap-small">
    <h2><%= t('.captured_events') %></h2>
    <% if @captured_events.any? %>
      <div class="event-rows">
        <% @captured_events.each do |event| %>
          <div class="event-row">
            <span class="muted event-row__date"><%= l(event.start_date) %></span>
            <div class="event-row__main">
              <%= link_to event.title, admin_event_path(event), class: 'event-row__title' %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="muted">—</p>
    <% end %>
  </section>

  <section class="flex flex-col gap-small">
    <h2><%= t('.permissions_heading') %></h2>
    <% if @user.admin? %>
      <p class="muted"><%= t('.permissions_admin') %></p>
    <% else %>
      <p class="muted"><%= t('.permissions_hint') %></p>
      <%= form_with url: permissions_admin_user_path(@user), method: :patch, class: 'flex flex-col gap-small' do %>
        <%= hidden_field_tag 'user[permissions][]', '', id: nil %>
        <% User::PERMISSIONS.each do |permission| %>
          <label class="flex gap-small align-baseline">
            <%= check_box_tag 'user[permissions][]', permission, @user.permissions.include?(permission), id: "permission_#{permission}" %>
            <span><%= t("admin.permissions.#{permission}.name") %> <span class="muted">— <%= t("admin.permissions.#{permission}.hint") %></span></span>
          </label>
        <% end %>
        <div><%= submit_tag t('.permissions_save'), class: 'button-small' %></div>
      <% end %>
    <% end %>
  </section>

  <% unless @user == current_user %>
    <section class="flex flex-col gap-small">
      <h2><%= t('.delete_heading') %></h2>
      <p class="muted"><%= t('.delete_hint') %></p>
      <%= button_to t('.delete'), admin_user_path(@user), method: :delete, class: "button delete",
            data: { turbo_confirm: t('.delete_confirm', username: @user.username) } %>
    </section>
  <% end %>
</div>
