<%# One event the model claims it read. Everything is editable and nothing is
    trusted: a value the normalizer refused is null here with the model's raw text
    shown beside it, because a human completes a null in one tap but only if they
    can still see what was claimed. Accepted by default — this is a list you prune,
    not one you assemble. %>
<%# locals: (candidate:, key:, error: nil) %>
<fieldset class="capture-candidate flex flex-col gap-small">
  <% if error.present? %>
    <p class="capture-candidate__error"><%= t("capture.errors.#{error}", default: t('capture.errors.unknown')) %></p>
  <% end %>

  <label class="capture-candidate__accept">
    <%# A row that came back from a refused publish stays kept: the contributor
        already chose it, and the fix is a field, not the decision. %>
    <%= check_box_tag "candidates[#{key}][accept]", "1", error.present? || !candidate.past?,
          data: { capture_target: "accept", action: "capture#syncRequired" } %>
    <span><%= t('capture.candidate.accept') %></span>
  </label>

  <label class="flex flex-col gap-xsmall">
    <span class="field-label"><%= t('capture.candidate.title') %></span>
    <%= text_field_tag "candidates[#{key}][title]", candidate.title, required: true %>
  </label>

  <div class="capture-candidate__when flex gap-small wrap">
    <label class="flex flex-col gap-xsmall">
      <span class="field-label"><%= t('capture.candidate.date') %></span>
      <%= date_field_tag "candidates[#{key}][date]", candidate.date, required: true %>
    </label>
    <label class="flex flex-col gap-xsmall">
      <span class="field-label"><%= t('capture.candidate.time') %></span>
      <%= text_field_tag "candidates[#{key}][time]", candidate.time, placeholder: "20:00" %>
    </label>
  </div>

  <% if candidate.past? %>
    <p class="capture-candidate__warning"><%= t('capture.candidate.past') %></p>
  <% end %>

  <label class="flex flex-col gap-xsmall">
    <span class="field-label"><%= t('capture.candidate.place') %></span>
    <%= text_field_tag "candidates[#{key}][place]", candidate.place %>
  </label>

  <%# Match-at-entry: tapping one of these is what stops a fourth spelling of
      "Quartierfest" from being minted, which is what keeps the place below the
      VenueLead nomination threshold forever. A suggestion never auto-applies. %>
  <% suggestions = place_suggestions(candidate) %>
  <% if suggestions.any? %>
    <div class="capture-candidate__suggestions flex gap-xsmall wrap">
      <span class="muted"><%= t('capture.candidate.suggestions') %></span>
      <% suggestions.each do |suggestion| %>
        <button type="button" class="chip"
                data-action="capture#applySuggestion"
                data-capture-name-param="<%= suggestion.name %>"
                data-capture-locality-param="<%= suggestion.locality %>"
                data-capture-canton-param="<%= suggestion.canton %>">
          <%= suggestion.name %>
        </button>
      <% end %>
    </div>
  <% end %>

  <div class="capture-candidate__where flex gap-small wrap">
    <label class="flex flex-col gap-xsmall">
      <%# Required HERE and not at extraction: a poster never prints its own town,
          but Location.add_to_tree drops any tuple missing the middle tier, so a
          blank locality is an event nobody can browse to. When the contributor
          genuinely doesn't know, the nearest named settlement beats a blank. %>
      <span class="field-label"><%= t('capture.candidate.locality') %></span>
      <%= text_field_tag "candidates[#{key}][locality]", candidate.locality,
            required: true, list: "capture-localities" %>
    </label>
    <label class="flex flex-col gap-xsmall">
      <span class="field-label"><%= t('capture.candidate.canton') %></span>
      <%= select_tag "candidates[#{key}][canton]",
            options_for_select(canton_options, candidate.canton),
            include_blank: true, required: true %>
    </label>
  </div>

  <label class="flex flex-col gap-xsmall">
    <span class="field-label"><%= t('capture.candidate.url') %></span>
    <%= url_field_tag "candidates[#{key}][url]", candidate.source_url, placeholder: "https://" %>
  </label>

  <label class="flex flex-col gap-xsmall">
    <span class="field-label"><%= t('capture.candidate.genres') %></span>
    <%= text_field_tag "candidates[#{key}][genres]", candidate.genres.join(", ") %>
  </label>

  <%# The interesting column: what the model claimed and we refused, and why. A
      rejected value is never silently dropped. %>
  <% if candidate.raw.any? %>
    <p class="capture-candidate__issues muted">
      <%= t('capture.candidate.refused', values: candidate.raw.values.join(", ")) %>
    </p>
  <% end %>
</fieldset>
