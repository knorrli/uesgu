<%# One event the model claims it read, as a card to decide on. Everything is
    editable and nothing is trusted: a value the normalizer refused is null here with
    the model's raw text beside it (see EventCapture::Candidate). Accepting publishes
    immediately. %>
<%# locals: (candidate:, key:, attempt_token: nil, index: nil, manual: false) %>
<%# A hand-entered card has no poster, and must NOT be given the source target: the
    controller empties that pane on connect to fill it from the browser-held blob, so
    the target would wipe the note (see capture_controller.js). %>
<% pane = manual ? { source: tag.p(t('capture.staging.by_hand'), class: "muted") }
                 : { source_attrs: { data: { capture_target: "source", action: "click->capture#zoom" } } } %>
<%= render layout: "shared/review_card",
      locals: { id: key, actions: render("captures/card_actions", key: key, rereadable: !manual),
                frame_class: "capture-card",
                frame_attrs: { data: { capture_target: "card", state: "open" } }, **pane } do %>
  <%= form_with url: capture_path, method: :post, id: "#{key}-form",
        class: "capture-card__fields account-form flex flex-col gap-small",
        data: { action: "turbo:submit-end->capture#decided change->capture#carryPlace" } do %>
    <%= hidden_field_tag :card_id, key, id: nil %>
    <%# What the model proposed, carried alongside what the human submits so the two
        can be diffed on accept — and on drop, where nothing else says what was
        thrown away (see ExtractionFieldOutcome). Client-tamperable, which is
        acceptable for a metric contributors report on their own work. %>
    <%= hidden_field_tag :attempt_token, attempt_token, id: nil %>
    <%= hidden_field_tag :candidate_index, index, id: nil %>
    <% proposed_fields(candidate).each do |field, value| %>
      <%= hidden_field_tag "proposed_#{field}", value, id: nil %>
    <% end %>
    <%# Set when a place suggestion filled the field, so picking the registry's
        spelling is not counted as the model having misread the poster. %>
    <% ExtractionFieldOutcome::PLACE_FIELDS.each do |field| %>
      <%= hidden_field_tag "normalized_#{field}", nil, id: nil %>
    <% end %>

    <label class="flex flex-col gap-xsmall">
      <span class="field-label"><%= t('capture.candidate.title') %></span>
      <%= text_field_tag :title, candidate.title, required: true %>
    </label>

    <label class="flex flex-col gap-xsmall">
      <span class="field-label"><%= t('capture.candidate.description') %></span>
      <%= text_field_tag :description, candidate.subtitle %>
    </label>
    <%= render "shared/cite", quote: cited_evidence(candidate, :subtitle) %>

    <div class="capture-card__when flex gap-small wrap">
      <label class="flex flex-col gap-xsmall">
        <span class="field-label"><%= t('capture.candidate.date') %></span>
        <%= date_field_tag :date, candidate.date, required: true %>
      </label>
      <label class="flex flex-col gap-xsmall">
        <span class="field-label"><%= t('capture.candidate.time') %></span>
        <%= text_field_tag :time, candidate.time %>
      </label>
    </div>
    <%= render "shared/cite", quote: cited_evidence(candidate, :date) %>

    <% if candidate.past? %>
      <p class="capture-card__warning"><%= t('capture.candidate.past') %></p>
    <% end %>

    <label class="flex flex-col gap-xsmall">
      <span class="field-label"><%= t('capture.candidate.place') %></span>
      <%= text_field_tag :place, candidate.place %>
    </label>
    <%= render "shared/cite", quote: cited_evidence(candidate, :place) %>

    <% suggestions = place_suggestions(candidate) %>
    <%= render "shared/suggestions", label: t('capture.candidate.suggestions'),
          chips: place_chips(suggestions) %>

    <div class="capture-card__where flex gap-small wrap">
      <label class="flex flex-col gap-xsmall">
        <%# Required HERE and not at extraction: a poster never prints its own town,
            but Location.add_to_tree drops any tuple missing the middle tier, so a
            blank locality is an event nobody can browse to. %>
        <span class="field-label"><%= t('capture.candidate.locality') %></span>
        <%= text_field_tag :locality, candidate.locality, required: true, list: "capture-localities" %>
      </label>
      <label class="flex flex-col gap-xsmall">
        <span class="field-label"><%= t('capture.candidate.canton') %></span>
        <%= select_tag :canton, options_for_select(canton_options, candidate.canton),
              include_blank: true, required: true %>
      </label>
    </div>
    <%= render "shared/cite", quote: cited_evidence(candidate, :locality) %>

    <%# The datalist behind the field offers every locality the app knows and shows
        none of them until you type, so a contributor who never guessed it is there is
        the one who mints "bern". These chips are the affordance where there is a
        ranking to render; where there is none, the line below is. %>
    <% towns = locality_chips(suggestions) %>
    <%= render "shared/suggestions", label: t('capture.candidate.locality_suggestions'),
          chips: towns %>
    <% if towns.empty? %>
      <span class="muted"><%= t('capture.candidate.locality_hint') %></span>
    <% end %>

    <label class="flex flex-col gap-xsmall">
      <span class="field-label"><%= t('capture.candidate.genres') %></span>
      <%# Free text on purpose: a poster names genres the taxonomy has never seen, and
          minting one is expected here. The suggestions exist so a genre we already
          carry is picked rather than respelt. Submits the same comma-joined string
          the text input did. %>
      <div class="input-wrapper flex capture-card__genres">
        <%= combobox_tag :genres, genre_options_capture_path, value: candidate.genres.join(","),
              free_text: true, multiselect_chip_src: genre_chips_capture_path,
              placeholder: t('capture.candidate.genres_placeholder'),
              dialog_label: t('capture.candidate.genres') do |combobox| %>
          <% combobox.customize_fieldset class: 'flex-grow' %>
          <% combobox.customize_input class: 'flex-grow' %>
        <% end %>
      </div>
      <span class="muted"><%= t('capture.candidate.genres_hint') %></span>
    </label>
  <% end %>

  <%# OUTSIDE the form, and deliberately: this is a report on the read, not a value of
      the event, and posting it with the publish would file it as one.

      Flagging beats re-sending the same request, because the provider is asked for no
      `temperature` and a model sampling deterministically answers an identical
      request identically (see EventCapture::Correction). %>
  <%# A hand-entered card has no input to read again. %>
  <% unless manual %>
    <div class="capture-card__reread account-form flex flex-col gap-small">
      <span class="muted"><%= t('capture.reread.label') %></span>
      <div class="flex gap-xsmall wrap">
        <% EventCapture::Correction::FIELDS.each do |field| %>
          <label class="tag">
            <%= check_box_tag "wrong", field, false, id: nil %>
            <%= t("capture.candidate.#{field}") %>
          </label>
        <% end %>
      </div>
      <%= text_field_tag :note, nil, id: nil, class: "capture-card__note",
            placeholder: t('capture.reread.note_placeholder') %>
      <p class="muted" data-spent hidden><%= t('capture.reread.spent') %></p>
    </div>
  <% end %>

  <%# The interesting column: what the model claimed and we refused, and why. A
      rejected value is never silently dropped. %>
  <% if candidate.raw.any? %>
    <p class="capture-card__issues muted">
      <%= t('capture.candidate.refused', values: candidate.raw.values.join(", ")) %>
    </p>
  <% end %>

  <div id="<%= key %>-status"></div>
<% end %>
