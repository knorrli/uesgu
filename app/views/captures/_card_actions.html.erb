<%# locals: (key:) %>
<%= render layout: "shared/action_bar" do %>
  <%# The bar is pinned outside the scrolling body, so the submit reaches its form by
      id rather than by containment. %>
  <%= submit_tag t('capture.actions.accept'), form: "#{key}-form", class: "button-small primary" %>
  <button type="button" class="button-small" data-action="capture#reject">
    <%= t('capture.actions.reject') %>
  </button>
<% end %>
