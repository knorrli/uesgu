<%# locals: (candidate:, key:, controller:, suggestions: false, genre_options: []) %>
<label class="flex flex-col gap-xsmall">
  <span class="field-label"><%= t('capture.candidate.title') %></span>
  <%= text_field_tag :title, candidate.title, required: true %>
</label>

<%= render layout: "shared/field_group",
      locals: { attached: render("shared/cite", quote: cited_evidence(candidate, :subtitle)) } do %>
  <label class="flex flex-col gap-xsmall">
    <span class="field-label"><%= t('capture.candidate.description') %></span>
    <%= text_field_tag :description, candidate.subtitle %>
  </label>
<% end %>

<div class="capture-fields__when flex gap-small wrap">
  <%= render layout: "shared/field_group",
        locals: { attached: render("shared/cite", quote: cited_evidence(candidate, :date)) } do %>
    <label class="flex flex-col gap-xsmall">
      <span class="field-label"><%= t('capture.candidate.date') %></span>
      <%= date_field_tag :date, candidate.date, required: true %>
    </label>
  <% end %>
  <%= render layout: "shared/field_group",
        locals: { attached: render("shared/cite", quote: cited_evidence(candidate, :time)) } do %>
    <label class="flex flex-col gap-xsmall">
      <span class="field-label"><%= t('capture.candidate.time') %></span>
      <%= render "shared/time_field", name: :time, value: candidate.time %>
    </label>
  <% end %>
  <% if candidate.past? %>
    <p class="capture-fields__warning"><%= t('capture.candidate.past') %></p>
  <% end %>
</div>

<% ranked = suggestions ? place_suggestions(candidate) : [] %>
<%= render layout: "shared/field_group",
      locals: { attached: [render("shared/cite", quote: cited_evidence(candidate, :place)),
                           render("shared/suggestions", label: t('capture.candidate.suggestions'),
                                  chips: place_chips(ranked, controller),
                                  attrs: { data: { suggestions: "place" },
                                           aria: { live: "polite" } })] } do %>
  <label class="flex flex-col gap-xsmall">
    <span class="field-label"><%= t('capture.candidate.place') %></span>
    <%= text_field_tag :place, candidate.place, autocomplete: "off",
          data: { action: "input->#{controller}#suggestPlaces change->#{controller}#typedPlace" } %>
  </label>
<% end %>

<% towns = suggestions ? locality_chips(ranked, candidate, controller) : [] %>
<%= render layout: "shared/field_group",
      locals: { attached: [render("shared/cite", quote: cited_evidence(candidate, :locality)),
                           render("shared/suggestions", label: t('capture.candidate.locality_suggestions'),
                                  chips: towns, attrs: { data: { suggestions: "locality" },
                                                         aria: { live: "polite" } })] } do %>
  <div class="capture-fields__where flex gap-small wrap">
    <label class="flex flex-col gap-xsmall">
      <span class="field-label"><%= t('capture.candidate.locality') %></span>
      <%= text_field_tag :locality, candidate.locality, required: true, autocomplete: "off",
            data: { action: "input->#{controller}#suggestLocalities change->#{controller}#typedPlace" } %>
    </label>
    <label class="flex flex-col gap-xsmall">
      <span class="field-label"><%= t('capture.candidate.canton') %></span>
      <%= select_tag :canton, options_for_select(canton_options, candidate.canton),
            include_blank: true, required: true,
            data: { action: "change->#{controller}#typedPlace" } %>
    </label>
  </div>
<% end %>

<%= render layout: "shared/field_group",
      locals: { attached: tag.span(t('capture.candidate.genres_hint'), class: "muted") } do %>
  <%= render "shared/genre_combobox", name: :genres, id: "#{key}-genres",
        value: candidate.genres.join(","), chip_src: genre_chips_capture_path,
        label: t('capture.candidate.genres'), options: genre_options %>
<% end %>
