<%# The fields an event is entered through, wherever that happens: the review card
    renders them beside a poster with the model's quotes attached, the hand-entry screen
    renders them alone. Most of that needs no branch — a quote for a field with no value
    renders nothing, and field_group drops what renders nothing.

    `suggestions` is what does. Place and locality chips are ranked from what a model
    read, so a screen with no read can only ever offer an empty row, and the hint that
    sits under an empty one promises towns will appear as you type — which only the
    capture controller delivers. %>
<%# locals: (candidate:, key:, suggestions: false, genre_options: []) %>
<label class="flex flex-col gap-xsmall">
  <span class="field-label"><%= t('capture.candidate.title') %></span>
  <%= text_field_tag :title, candidate.title, required: true %>
</label>

<%= render layout: "shared/field_group",
      locals: { attached: render("shared/cite", quote: cited_evidence(candidate, :subtitle)) } do %>
  <label class="flex flex-col gap-xsmall">
    <span class="field-label"><%= t('capture.candidate.description') %></span>
    <%= text_field_tag :description, candidate.subtitle %>
  </label>
<% end %>

<div class="capture-fields__when flex gap-small wrap">
  <%= render layout: "shared/field_group",
        locals: { attached: render("shared/cite", quote: cited_evidence(candidate, :date)) } do %>
    <label class="flex flex-col gap-xsmall">
      <span class="field-label"><%= t('capture.candidate.date') %></span>
      <%= date_field_tag :date, candidate.date, required: true %>
    </label>
  <% end %>
  <%= render layout: "shared/field_group",
        locals: { attached: render("shared/cite", quote: cited_evidence(candidate, :time)) } do %>
    <label class="flex flex-col gap-xsmall">
      <span class="field-label"><%= t('capture.candidate.time') %></span>
      <%# Native, and must stay so: mobile Safari keeps its own control metrics for a
          date input whatever height the stylesheet sets, so a text field beside one
          draws its underline at a different height. The value is always HH:MM or
          blank — a time the normalizer refused is null with the raw text cited
          beside it (see EventCapture::Normalizer). %>
      <%= time_field_tag :time, candidate.time %>
    </label>
  <% end %>
  <%# In the row rather than in the date group's `attached`, where every other remark
      on this card hangs off the field it concerns: half a row is too narrow for the
      sentence, and the row is the narrowest thing that is not. %>
  <% if candidate.past? %>
    <p class="capture-fields__warning"><%= t('capture.candidate.past') %></p>
  <% end %>
</div>

<% ranked = suggestions ? place_suggestions(candidate) : [] %>
<%= render layout: "shared/field_group",
      locals: { attached: [render("shared/cite", quote: cited_evidence(candidate, :place)),
                           (render("shared/suggestions", label: t('capture.candidate.suggestions'),
                                   chips: place_chips(ranked)) if suggestions)] } do %>
  <label class="flex flex-col gap-xsmall">
    <span class="field-label"><%= t('capture.candidate.place') %></span>
    <%= text_field_tag :place, candidate.place %>
  </label>
<% end %>

<%# Chips are the affordance where there is a ranking to render; where there is
    none, the hint that takes their slot is. The same row also holds the towns
    matching what is being typed, appended in the browser (see
    capture_controller.js), which is how the long tail stays reachable at all.
    Both hang off the PAIR: a chip fills the canton as well as the town (see
    CapturesHelper#locality_chips), and the canton is computed from the locality
    rather than read off the poster (see EventCapture::Normalizer). %>
<% towns = suggestions ? locality_chips(ranked, candidate) : [] %>
<% unranked_hint = tag.span(t('capture.candidate.locality_hint'), class: "muted",
                            data: { locality_hint: true }) if suggestions && towns.empty? %>
<%= render layout: "shared/field_group",
      locals: { attached: [render("shared/cite", quote: cited_evidence(candidate, :locality)),
                           (render("shared/suggestions", label: t('capture.candidate.locality_suggestions'),
                                   chips: towns, attrs: { data: { suggestions: "locality" },
                                                          aria: { live: "polite" } }) if suggestions),
                           unranked_hint] } do %>
  <div class="capture-fields__where flex gap-small wrap">
    <label class="flex flex-col gap-xsmall">
      <%# Required HERE and not at extraction: a poster never prints its own town,
          but Location.add_to_tree drops any tuple missing the middle tier, so a
          blank locality is an event nobody can browse to. %>
      <span class="field-label"><%= t('capture.candidate.locality') %></span>
      <%# autocomplete off because `name="locality"` is an address autofill token and
          the field sits beside a canton: iOS otherwise offers to fill it with a whole
          postal address ("Bern 3008 Switzerland"), which mints that as a town. %>
      <%= text_field_tag :locality, candidate.locality, required: true, autocomplete: "off",
            data: { action: ("input->capture#suggestLocalities" if suggestions) } %>
    </label>
    <label class="flex flex-col gap-xsmall">
      <span class="field-label"><%= t('capture.candidate.canton') %></span>
      <%= select_tag :canton, options_for_select(canton_options, candidate.canton),
            include_blank: true, required: true %>
    </label>
  </div>
<% end %>

<%= render layout: "shared/field_group",
      locals: { attached: tag.span(t('capture.candidate.genres_hint'), class: "muted") } do %>
  <%# The label names the field with `for` and must NOT wrap it, unlike every other
      field here. The gem draws a selection as a chip inside the field, and a tap on
      one targets the chip — inside a wrapping label that is a click on the label, so
      the browser forwards activation to the labelled input as a second click at the
      same coordinates, defeating the chip's remover. The gem ids the input with a
      random uuid unless given one, so the label needs an id the caller can build. %>
  <div class="flex flex-col gap-xsmall">
    <label class="field-label" for="<%= key %>-genres"><%= t('capture.candidate.genres') %></label>
    <%# Free text on purpose: a poster names genres the taxonomy has never seen, and
        minting one is expected here. The suggestions exist so a genre we already
        carry is picked rather than respelt. Submits a comma-joined string. %>
    <div class="input-wrapper flex capture-fields__genres">
      <%# `mobile_at` is the width at or below which the gem swaps its inline listbox
          for a modal <dialog>; a width no viewport can be under keeps the listbox
          everywhere. On a phone the dialog covers the screen from the middle down and
          still shows fewer options than the dropdown it replaces, because the software
          keyboard eats the bottom of it.

          Sync options and not a src, so typing filters what is already here: a request
          per keystroke answers a query the contributor has usually typed past by the
          time it lands, and on mobile data the late answer overwrites the current list. %>
      <%= combobox_tag :genres, genre_options, value: candidate.genres.join(","),
            id: "#{key}-genres", mobile_at: "0px",
            free_text: true, multiselect_chip_src: genre_chips_capture_path,
            placeholder: t('capture.candidate.genres_placeholder') do |combobox| %>
        <% combobox.customize_fieldset class: 'flex-grow' %>
        <% combobox.customize_input class: 'flex-grow' %>
      <% end %>
    </div>
  </div>
<% end %>
