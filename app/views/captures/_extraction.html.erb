<%# locals: (id:, label:, extraction:) %>
<div id="<%= id %>" class="capture-row flex flex-col gap-medium">
  <% if !extraction.ok? %>
    <p class="capture-row__label field-label"><%= label.presence || t('capture.row.untitled') %></p>
    <p class="capture-row__failure" data-failed>
      <%= t("capture.failures.#{extraction.code}", default: t('capture.failures.unknown')) %>
    </p>
    <% if extraction.retryable? %>
      <button type="button" class="button-small capture-row__retry"
              data-action="capture#retry"><%= t('capture.row.retry') %></button>
    <% end %>
  <% elsif extraction.candidates.empty? %>
    <p class="capture-row__label field-label"><%= label.presence || t('capture.row.untitled') %></p>
    <p class="muted"><%= t('capture.row.nothing_found') %></p>
  <% else %>
    <% extraction.candidates.each_with_index do |candidate, index| %>
      <%= render "captures/candidate", candidate: candidate, key: "#{id}-#{index}",
            attempt_token: extraction.attempt_token, index: index %>
    <% end %>
  <% end %>
</div>
