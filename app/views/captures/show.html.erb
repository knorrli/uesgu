<% content_for :title, t('capture.title') %>

<div class="capture flex flex-col gap-large"
     data-controller="capture"
     data-capture-url-value="<%= extract_capture_path %>"
     data-capture-max-edge-value="1568"
     data-capture-pending-value="<%= t('capture.row.pending') %>"
     data-capture-error-value="<%= t('capture.failures.unreachable') %>"
     data-capture-undecodable-value="<%= t('capture.failures.image_unsupported') %>"
     data-capture-source-alt-value="<%= t('capture.row.source_alt') %>">
  <%= render layout: "shared/page_header", locals: { back_path: root_path, back_label: t('nav.events') } do %>
    <h1><%= t('capture.title') %></h1>
    <p class="muted"><%= t('capture.intro') %></p>
  <% end %>

  <%# Outside the publish form on purpose: picking an input fires its own request
      per file, and a file field inside the form would re-upload every poster when
      the verified events are finally submitted. %>
  <div class="capture-picker account-form flex flex-col gap-medium">
    <label class="flex flex-col gap-small">
      <span class="field-label"><%= t('capture.images_label') %></span>
      <p class="muted"><%= t('capture.images_hint') %></p>
      <input type="file" accept="image/*" multiple data-capture-target="files"
             data-action="change->capture#pickFiles">
    </label>

    <label class="flex flex-col gap-small">
      <span class="field-label"><%= t('capture.text_label') %></span>
      <p class="muted"><%= t('capture.text_hint') %></p>
      <textarea rows="4" data-capture-target="text"></textarea>
    </label>
    <div>
      <button type="button" class="button-small" data-action="capture#pickText"><%= t('capture.text_button') %></button>
    </div>
  </div>

  <%# Every locality the app already knows, so the common answer is one keystroke
      while an unlisted one can still be typed: this field is free text, not a
      closed set. %>
  <datalist id="capture-localities">
    <% capture_localities.each do |locality| %><option value="<%= locality %>"></option><% end %>
  </datalist>

  <%# Progress, navigation and receipts in one strip: a card publishes the moment it
      is accepted and moves on, so its tile is the only thing left saying so. %>
  <nav class="capture-queue" data-capture-target="strip" aria-label="<%= t('capture.queue.label') %>" hidden></nav>

  <div id="capture-rows" class="flex flex-col gap-medium" data-capture-target="rows"></div>

  <%= tag.p t('capture.empty'), class: "empty-state", data: { capture_target: "empty" } %>
  <%= tag.p t('capture.queue.done'), class: "empty-state", data: { capture_target: "done" }, hidden: true %>
</div>
