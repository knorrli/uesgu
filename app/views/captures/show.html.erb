<% content_for :title, t('capture.title') %>
<% localities = capture_localities %>
<% found = capture_found_titles %>

<div class="capture flex flex-col gap-large"
     data-controller="capture"
     data-capture-url-value="<%= extract_capture_path %>"
     data-capture-drop-url-value="<%= drop_capture_path %>"
     data-capture-max-edge-value="1568"
     data-capture-pending-value="<%= t('capture.row.pending') %>"
     data-capture-error-value="<%= t('capture.failures.unreachable') %>"
     data-capture-undecodable-value="<%= t('capture.failures.image_unsupported') %>"
     data-capture-remove-value="<%= t('capture.staging.remove') %>"
     data-capture-source-alt-value="<%= t('capture.row.source_alt') %>"
     data-capture-localities-value="<%= localities.to_json %>"
     data-capture-blank-url-value="<%= blank_capture_path %>"
     data-capture-by-hand-value="<%= t('capture.staging.by_hand') %>"
     data-capture-found-one-value="<%= found[:one] %>"
     data-capture-found-other-value="<%= found[:other] %>">
  <%= render layout: "shared/page_header", locals: { back_path: root_path, back_label: t('nav.events') } do %>
    <h1 data-capture-target="stagingTitle"><%= t('capture.title') %></h1>
    <h1 data-capture-target="reviewTitle" hidden></h1>
    <p class="muted"><%= t('capture.intro') %></p>
  <% end %>

  <div class="flex flex-col gap-medium" data-capture-target="input">
    <div class="capture-picker account-form flex flex-col gap-medium">
      <%= render "shared/drop_zone",
            id: "capture-files", label: t('capture.staging.drop_label'), hint: t('capture.images_hint'),
            input_attrs: { accept: "image/*", multiple: true,
                           data: { capture_target: "files", action: "change->capture#stageFiles" } },
            zone_attrs: { data: { capture_target: "zone",
                                  action: "dragover->capture#dragOver dragleave->capture#dragLeave drop->capture#dropFiles" } },
            items_attrs: { data: { capture_target: "items" } } %>

      <label class="flex flex-col gap-small">
        <span class="field-label"><%= t('capture.text_label') %></span>
        <p class="muted"><%= t('capture.text_hint') %></p>
        <textarea rows="4" data-capture-target="text"></textarea>
      </label>
      <div class="flex gap-small wrap">
        <button type="button" class="button-small" data-action="capture#stageText"><%= t('capture.staging.add_text') %></button>
        <button type="button" class="button-small button-ghost" data-action="capture#stageBlank"><%= t('capture.staging.add_by_hand') %></button>
      </div>
    </div>

    <%# Below the picker and full width, so it reads as the one commit for everything
        above it rather than as a second button belonging to the text field. %>
    <button type="button" class="button primary capture-commit" data-capture-target="commit"
            data-action="capture#commit" disabled><%= t('capture.staging.commit') %></button>
  </div>

  <%# Every locality the app already knows, so the common answer is one keystroke
      while an unlisted one can still be typed: this field is free text, not a
      closed set. %>
  <datalist id="capture-localities">
    <% localities.each_key do |locality| %><option value="<%= locality %>"></option><% end %>
  </datalist>

  <%# Progress, navigation and receipts in one strip: a card publishes the moment it
      is accepted and moves on, so its tile is the only thing left saying so. %>
  <nav class="capture-queue" data-capture-target="strip" aria-label="<%= t('capture.queue.label') %>" hidden></nav>

  <div id="capture-rows" class="flex flex-col gap-medium" data-capture-target="rows"></div>

  <%= tag.p t('capture.queue.done'), class: "empty-state", data: { capture_target: "done" }, hidden: true %>

  <div data-capture-target="restart" hidden>
    <button type="button" class="text-link" data-action="capture#startOver"><%= t('capture.staging.start_over') %></button>
  </div>
</div>
