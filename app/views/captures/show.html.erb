<% content_for :title, t('capture.title') %>
<% localities = capture_localities %>
<% found = capture_found_titles %>

<div class="capture flex flex-col gap-large"
     data-controller="capture"
     data-action="paste@document->capture#pasted"
     data-capture-url-value="<%= extract_capture_path %>"
     data-capture-drop-url-value="<%= drop_capture_path %>"
     data-capture-max-edge-value="1568"
     data-capture-pending-value="<%= t('capture.row.pending') %>"
     data-capture-error-value="<%= t('capture.failures.unreachable') %>"
     data-capture-undecodable-value="<%= t('capture.failures.image_unsupported') %>"
     data-capture-source-alt-value="<%= t('capture.row.source_alt') %>"
     data-capture-pasted-value="<%= t('capture.row.pasted') %>"
     data-capture-localities-value="<%= localities.to_json %>"
     data-capture-places-value="<%= capture_places.to_json %>"
     data-capture-found-one-value="<%= found[:one] %>"
     data-capture-found-other-value="<%= found[:other] %>"
     data-capture-done-value="<%= capture_done_flashes.to_json %>">
  <%= render layout: "shared/page_header", locals: { back_path: root_path, back_label: t('nav.events') } do %>
    <div class="flex justify-between align-center wrap gap-medium">
      <h1 data-capture-target="stagingTitle"><%= t('capture.title') %></h1>
      <h1 data-capture-target="reviewTitle" hidden></h1>
      <%= link_to t('capture.picker.add_by_hand'), manual_capture_path,
            class: "button-small", data: { capture_target: "byHand" } %>
      <button type="button" class="text-link" data-capture-target="restart"
              data-action="capture#startOver" hidden><%= t('capture.picker.start_over') %></button>
    </div>
    <p class="muted" data-capture-target="reviewHint" hidden><%= t('capture.review.hint') %></p>
  <% end %>

  <div class="capture-picker account-form flex flex-col gap-large" data-capture-target="input">
    <%= render "shared/drop_zone",
          id: "capture-files", label: t('capture.picker.drop_label'), hint: t('capture.images_hint'),
          paste_label: t('capture.picker.paste'), paste_error: t('capture.picker.paste_empty'),
          input_attrs: { accept: "image/*", multiple: true,
                         data: { capture_target: "files", action: "change->capture#readFiles" } },
          zone_attrs: { data: { capture_target: "zone",
                                action: "dragover->capture#dragOver dragleave->capture#dragLeave drop->capture#dropFiles" } },
          paste_attrs: { data: { capture_target: "paste", action: "capture#pasteImages" } },
          error_attrs: { data: { capture_target: "pasteError" } } %>

    <div class="capture-text">
      <label class="field-label" for="capture-text"><%= t('capture.text_label') %></label>
      <p class="muted"><%= t('capture.text_hint') %></p>
      <textarea id="capture-text" rows="4" data-capture-target="text"
                data-action="input->capture#refreshRead"></textarea>
      <button type="button" class="button-small primary" data-capture-target="read"
              data-action="capture#readText" disabled><%= t('capture.picker.read_text') %></button>
    </div>
  </div>

  <template data-capture-target="genreOptions">
    <% combobox_options(genre_combobox_options(Genre.offerable)).each do |option| %><%= render option %><% end %>
  </template>

  <nav class="capture-queue" data-capture-target="strip" aria-label="<%= t('capture.queue.label') %>" hidden></nav>

  <div id="capture-rows" class="flex flex-col gap-medium" data-capture-target="rows"></div>
</div>
