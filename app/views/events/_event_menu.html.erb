<%# locals: (event:, genres:, interactive:, return_to: nil) %>
<% excludable = interactive && current_user.present? %>
<% curatable = current_user&.can?(:curate_events) %>
<% if excludable || curatable %>
<details class="nav-menu event-menu" data-controller="menu" data-action="toggle->menu#toggle">
  <summary class="icon-button" title="<%= t('events.event_menu') %>" aria-label="<%= t('events.event_menu') %>"><span class="ph ph-gear" aria-hidden="true"></span></summary>
  <div class="nav-menu__items event-menu__panel">
    <% if excludable %>
      <% places = [event.venue, *canton_last(event.locations)].compact.uniq %>
      <details class="exclude-menu">
        <summary class="nav-menu__item">
          <span class="ph ph-eye-slash" aria-hidden="true"></span>
          <span><%= t('events.exclude_menu') %></span>
          <span class="ph ph-caret-right exclude-menu__caret" aria-hidden="true"></span>
        </summary>
        <div class="exclude-menu__items">
          <% places.each do |place| %>
            <%= button_to location_exclusions_path, params: { name: place.name, return_to: request.fullpath }, class: 'nav-menu__item',
                  'aria-label': t('events.exclude_location', location: place.name), form: { data: { turbo_frame: '_top' } } do %>
              <span class="ph ph-map-pin" aria-hidden="true"></span>
              <span><%= place.name %></span>
            <% end %>
          <% end %>
          <% genres.each do |genre| %>
            <%= button_to genre_exclusions_path, params: { name: genre.name, return_to: request.fullpath }, class: 'nav-menu__item',
                  'aria-label': t('events.exclude_genre', genre: genre.name), form: { data: { turbo_frame: '_top' } } do %>
              <span class="ph ph-music-notes" aria-hidden="true"></span>
              <span><%= genre.name %></span>
            <% end %>
          <% end %>
        </div>
      </details>
    <% end %>
    <% if curatable %>
      <%= link_to admin_event_path(event), class: 'nav-menu__item', data: { turbo_frame: '_top' } do %>
        <span class="ph ph-gear" aria-hidden="true"></span>
        <span><%= t('events.edit_event') %></span>
      <% end %>
      <%= button_to event, method: :delete, params: { return_to: return_to }.compact, class: 'nav-menu__item danger' do %>
        <span class="ph ph-trash" aria-hidden="true"></span>
        <span><%= t('events.delete_event') %></span>
      <% end %>
    <% end %>
  </div>
</details>
<% end %>
