<div class="flex flex-col gap-large align-stretch">
  <%= render 'filter_sheets' %>

  <% unless @has_results %>
    <p class="muted events-empty">
      <%= t('events.index.empty') %>
      <% if @filter.active? %>
        <%= link_to t('events.index.clear_filter'), events_path(filtered: 1), class: 'events-empty__reset' %>
      <% end %>
    </p>
  <% end %>

  <% if @events.any? %>
    <%= render 'events', events: @events %>
  <% end %>
</div>

