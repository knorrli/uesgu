<!DOCTYPE html>
<% theme = cookies[:theme].presence_in(%w[light dark]) %>
<html<%= " data-theme=\"#{theme}\"".html_safe if theme %>>
  <head>
    <title><%= ["üsgu", content_for(:title).presence].compact.join(" | ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#17131a">

    <meta name="turbo-prefetch" content="false">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/favicon.ico?v=<%= ICON_VERSION %>" sizes="any">
    <link rel="icon" href="/icon.svg?v=<%= ICON_VERSION %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=<%= ICON_VERSION %>">

    <%= render "layouts/ios_splash_screens" %>

    <script nonce="<%= content_security_policy_nonce %>">
      (function () {
        if (document.documentElement.dataset.theme) return
        var t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"
        document.documentElement.dataset.theme = t
        document.cookie = "theme=" + t + ";path=/;max-age=31536000;samesite=lax"
      })()
    </script>

    <%= tag.link rel: "preload", href: asset_path("Phosphor.woff2"), as: "font", type: "font/woff2", crossorigin: "anonymous" %>

    <%= combobox_style_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= class_names(yield(:body_class)) %>">
    <div class="flashes" role="status" aria-live="polite">
      <% if notice.present? %><p class="flash notice"><%= notice %></p><% end %>
      <% if alert.present? %><p class="flash alert"><%= alert %></p><% end %>
    </div>

    <header class="site-header">
      <div class="site-header__inner">
        <div class="site-header__brand">
          <%= link_to 'üsgu', root_path, class: 'site-brand' %>
          <button type="button" class="theme-toggle" aria-label="<%= t('nav.theme') %>"
                  data-controller="theme" data-action="theme#toggle">
            <span class="ph <%= theme == 'light' ? 'ph-sun' : 'ph-moon' %>" data-theme-target="icon" aria-hidden="true"></span>
          </button>
        </div>
        <nav class="site-nav">
          <%= link_to install_path, class: 'nav-install', hidden: true, 'aria-label': t('nav.install'), data: { controller: 'install-link' } do %>
            <span class="ph ph-download-simple" aria-hidden="true"></span>
            <span class="nav-install__label"><%= t('nav.install') %></span>
          <% end %>
          <% if authenticated? %>
            <% unread = current_user.notifications.unread.count %>
            <details class="nav-menu" data-controller="menu" data-action="toggle->menu#toggle">
              <summary><%= current_user.username %><% if unread.positive? %> <span class="unread-dot" role="img" aria-label="<%= t('nav.unread_notifications') %>"></span><% end %></summary>
              <div class="nav-menu__items">
                <% if current_user.contributor? %>
                  <%= link_to capture_path, class: 'nav-menu__item' do %>
                    <span class="ph ph-calendar-plus" aria-hidden="true"></span>
                    <span><%= t('nav.capture') %></span>
                  <% end %>
                <% end %>
                <%= link_to notifications_path, class: 'nav-menu__item' do %>
                  <span class="ph ph-bell" aria-hidden="true"></span>
                  <span><%= t('nav.notifications') %></span><% if unread.positive? %> <span class="badge"><%= unread %></span><% end %>
                <% end %>
                <%= link_to saved_filters_path, class: 'nav-menu__item' do %>
                  <span class="ph ph-funnel" aria-hidden="true"></span>
                  <span><%= t('nav.filters') %></span>
                <% end %>
                <%= link_to saved_events_path, class: 'nav-menu__item' do %>
                  <span class="ph ph-heart" aria-hidden="true"></span>
                  <span><%= t('nav.saved') %></span>
                <% end %>
                <%= link_to settings_path, class: 'nav-menu__item' do %>
                  <span class="ph ph-gear" aria-hidden="true"></span>
                  <span><%= t('nav.settings') %></span>
                <% end %>
                <% if current_user.admin? %>
                  <%= link_to admin_path, class: 'nav-menu__item' do %>
                    <span class="ph ph-wrench" aria-hidden="true"></span>
                    <span><%= t('nav.admin') %></span>
                  <% end %>
                <% end %>
              </div>
            </details>
          <% else %>
            <% unless current_page?(new_session_path) %>
              <%= link_to t('nav.login'), new_session_path %>
            <% end %>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="content">
      <%= yield %>
    </main>

    <%= render 'shared/footer' %>

    <%= render 'shared/cookie_notice' %>
  </body>
</html>
