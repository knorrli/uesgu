<% content_for :title, t('about.title') %>

<div class="text-page flex flex-col gap-large">
  <%= render layout: "shared/page_header", locals: { back_path: root_path, back_label: t('nav.events') } do %>
    <h1><%= t('about.heading') %></h1>
  <% end %>

  <div class="prose flex flex-col gap-medium">
    <p><%= t('about.intro') %></p>
    <h2><%= t('about.why.title') %></h2>
    <p><%= t('about.why.body') %></p>
    <h2><%= t('about.account.title') %></h2>
    <p><%= t('about.account.body') %></p>
    <h2><%= t('about.how.title') %></h2>
    <p><%= t('about.how.body') %></p>
    <h3><%= t('about.how.crawler.title') %></h3>
    <p><%= t('about.how.crawler.body') %></p>
    <h3><%= t('about.how.capture.title') %></h3>
    <p><%= t('about.how.capture.body') %></p>
    <h2><%= t('about.contact.title') %></h2>
    <p><%= t('about.contact.body', email: t('about.contact.email')) %></p>
  </div>
</div>
