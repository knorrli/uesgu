<%# A file picker that is also a drop target: drop files on it, or tap it to open the
    system picker. What happens on pick is the caller's — nothing is staged here.

    The real <input type="file"> is kept and only visually hidden. The drop handler is
    an enhancement — without the input, keyboard users and every iOS browser lose the
    picker entirely. %>
<%# locals: (id:, label:, hint: nil, input_attrs: {}, zone_attrs: {}) %>
<%= tag.div class: "drop-zone", **zone_attrs do %>
  <label class="drop-zone__target" for="<%= id %>">
    <span class="ph ph-camera" aria-hidden="true"></span>
    <span><%= label %></span>
    <% if hint.present? %><span class="drop-zone__hint muted"><%= hint %></span><% end %>
  </label>
  <%= tag.input type: "file", id: id, class: "drop-zone__input", **input_attrs %>
<% end %>
