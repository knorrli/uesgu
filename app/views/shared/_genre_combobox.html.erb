<%# locals: (name:, id:, value:, chip_src:, label:, badge: nil, options: []) %>
<div class="flex flex-col gap-xsmall">
  <label class="field-label flex gap-small align-baseline" for="<%= id %>">
    <%= label %>
    <%= badge %>
  </label>
  <div class="input-wrapper flex genre-combobox">
    <%= combobox_tag name, options, value: value, id: id,
          mobile_at: "0px", free_text: true, multiselect_chip_src: chip_src,
          placeholder: t("genres.combobox.placeholder"),
          dialog_label: t("genres.combobox.placeholder") do |combobox| %>
      <% combobox.customize_fieldset class: 'flex-grow' %>
      <% combobox.customize_input class: 'flex-grow' %>
    <% end %>
  </div>
</div>
