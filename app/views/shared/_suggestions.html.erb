<%# Values the app already carries, offered as chips beside the field they fill. What
    tapping one does is the caller's business — a place suggestion fills three fields,
    a locality one fills two — so the action rides in on each chip's own attributes.
    None of them ever auto-applies. A row holding no chips shows nothing (tags.css), so
    a caller may render one empty, name it through `attrs`, and fill it as they type. %>
<%# locals: (label:, chips:, attrs: {}) %>
<%= tag.div class: "suggestions flex gap-xsmall wrap", **attrs do %>
  <span class="muted"><%= label %></span>
  <% chips.each do |chip| %>
    <%= tag.button chip[:label], type: "button", class: "chip", **chip[:attrs] %>
  <% end %>
<% end %>
