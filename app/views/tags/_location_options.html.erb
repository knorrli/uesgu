<% location_filter_tree.each do |canton| %>
  <div class="loc-group collapsed" data-filter-sheets-target="group">
    <%= render "tags/tree_head", name: canton[:name], title: canton[:title], count: canton[:count],
          search: canton[:search], expandable: canton[:children].any?, type: t('events.filter.location_types.canton'),
          param: "l[]", value: canton[:value], checked: filter.location_list.include?(canton[:value]) %>
    <div class="loc-group__body">
      <% canton[:children].each do |locality| %>
        <% if locality[:children].any? %>
          <div class="loc-group loc-group--nested collapsed" data-filter-sheets-target="group">
            <%= render "tags/tree_head", name: locality[:name], count: locality[:count], level: :mid,
                  search: locality[:search], expandable: true, type: t('events.filter.location_types.locality'),
                  param: "l[]", value: locality[:value], checked: filter.location_list.include?(locality[:value]) %>
            <div class="loc-group__body">
              <% locality[:children].each do |venue| %>
                <label class="opt opt--leaf" data-search="<%= venue[:search] %>">
                  <input type="checkbox" name="l[]" value="<%= venue[:value] %>" <%= 'checked' if filter.location_list.include?(venue[:value]) %>>
                  <span class="opt__box"></span>
                  <span class="opt__label"><%= venue[:name] %></span>
                  <span class="opt__count"><%= venue[:count] %></span>
                </label>
              <% end %>
            </div>
          </div>
        <% else %>
          <%= render "tags/tree_head", name: locality[:name], count: locality[:count], level: :mid,
                search: locality[:search], expandable: false, type: t('events.filter.location_types.locality'),
                param: "l[]", value: locality[:value], checked: filter.location_list.include?(locality[:value]) %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
